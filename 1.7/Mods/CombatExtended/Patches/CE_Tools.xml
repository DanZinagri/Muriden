<?xml version="1.0" encoding="utf-8"?>
<!-- Combat Extended only (loadFolders). CE treats any melee tool that is not a ToolCE as unsupported: its stat
     workers log "no support for Combat Extended", and its melee verb throws a NullReferenceException on every sharp hit
     (DamageInfosToApply reads ToolCE.capacities without a null check). Each tool keeps its vanilla fields and only
     gets the ToolCE class plus CE's two penetration values: sharp in mm RHA, blunt in MPa. -->
<Patch>

	<!-- Gene attacks -->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationAttributeSet">
				<xpath>Defs/HediffDef[defName="Muriden_Bite"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools/li[label="bite"]</xpath>
				<attribute>Class</attribute>
				<value>CombatExtended.ToolCE</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/HediffDef[defName="Muriden_Bite"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools/li[label="bite"]</xpath>
				<value>
				<armorPenetrationSharp>0.5</armorPenetrationSharp>
				<armorPenetrationBlunt>2.0</armorPenetrationBlunt>
				</value>
			</li>
		</operations>
	</Operation>
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationAttributeSet">
				<xpath>Defs/HediffDef[defName="Muriden_Claws"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools/li[label="talons"]</xpath>
