        <exclusionTags>
            <li>BodySize</li>
            <li>Body_Size_Multiplier</li>
        </exclusionTags>
        <selectionWeight>0</selectionWeight>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <marketValueFactor>1.0</marketValueFactor>
    </GeneDef>

    <GeneDef ParentName="Muriden_FrameBase">
        <defName>Muriden_Frame</defName>
        <label>muriden frame</label>
        <description>Muriden of this gene are barely taller than a human child, and built light with it.</description>
        <iconPath>UI/Icons/Genes/Muriden_Icon</iconPath>
        <displayOrderInCategory>1050</displayOrderInCategory>
        <biostatCpx>6</biostatCpx>
        <biostatMet>10</biostatMet>
        <statFactors>
            <SM_BodySizeMultiplier>0.80</SM_BodySizeMultiplier>
            <MiningSpeed>0.7125</MiningSpeed>
            <ConstructionSpeed>0.7125</ConstructionSpeed>
            <DeepDrillingSpeed>0.95</DeepDrillingSpeed>
            <MoveSpeed>0.93</MoveSpeed>
            <SM_RaidWealthMultiplier>0.6</SM_RaidWealthMultiplier>
        </statFactors>
        <statOffsets>
            <SM_BodySizeOffset>-0.35</SM_BodySizeOffset>
            <SM_RaidWealthOffset>-1000</SM_RaidWealthOffset>
            <MeleeHitChance>1</MeleeHitChance>
        </statOffsets>
    </GeneDef>

    <GeneDef ParentName="Muriden_FrameBase">
