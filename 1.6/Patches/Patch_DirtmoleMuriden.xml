<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <!-- Each wrapper checks the C# setting before applying its operation -->
    <Operation Class="MuridenLibraries.PatchOp_dirtmolePatch">
        <match Class="PatchOperationAdd">
            <xpath>/Defs/XenotypeDef[defName="Dirtmole"]/genes</xpath>
            <value>
                <li>Muriden_Frame</li>
                <li>Muriden_SmallToughness</li>
                <li>Body_FemaleOnly</li>
                <li>Ears_Muriden</li>
                <li>Tail_Muriden</li>
                <li>Body_Thin</li>
                <li>Body_Standard</li>
                <li>Dirtmole_Resilience</li>
                <li MayRequire="redmattis.bettergeneinheritance">BGI_PrimaryGenes</li>
            </value>
        </match>
    </Operation>
    <Operation Class="MuridenLibraries.PatchOp_dirtmolePatch">
        <match Class="PatchOperationRemove">
            <success>Always</success>
            <xpath>/Defs/XenotypeDef[defName="Dirtmole"]/genes/li[text()="Skin_LightGray"]</xpath>
        </match>
    </Operation>
    <Operation Class="MuridenLibraries.PatchOp_dirtmolePatch">
        <match Class="PatchOperationRemove">
            <success>Always</success>
            <xpath>/Defs/XenotypeDef[defName="Dirtmole"]/genes/li[text()="Eyes_Gray"]</xpath>
        </match>
    </Operation>

</Patch>
