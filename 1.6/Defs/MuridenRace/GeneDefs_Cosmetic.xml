									<bodyPartDef>Tail</bodyPartDef>
									<partMissing>true</partMissing>
								</li>
							</triggerBodyPart>
							<texturePaths><default>BS_Blank</default></texturePaths>
						</li>
					</alts>
				</conditionalGraphics>
				<drawData>
					<!-- Absolute offsets: the shared numbers x 0.8, which is where Thin sits today.
						Thin is narrow (bodyGraphicScale 0.6, 1) but full height, yet the vertical
						values were being shrunk by that same 0.8 - raising the z values back toward
						the shared numbers is likely the fix. -->
					<scaleOffsetByBodySize>false</scaleOffsetByBodySize>
					<defaultData>
						<layer>-2</layer>
					</defaultData>
					<dataNorth>
						<offset>(-0.08, 0.16, 0.08)</offset>
						<layer>90</layer>
					</dataNorth>
					<dataSouth>
						<offset>(0.08, -0.08, 0.08)</offset>
					</dataSouth>
					<dataEast>
						<offset>(-0.55, -0.08, -0.08)</offset>
					</dataEast>
					<dataWest>
